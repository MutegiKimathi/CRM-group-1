    def_r = y_test[approved].mean() * 100 if approved.sum() > 0 else 0
    pred_t  = (gb_proba >= t).astype(int)
    rec     = recall_score(y_test, pred_t, zero_division=0)
    f1      = f1_score(y_test, pred_t, zero_division=0)
    el      = (def_r / 100) * LGD * AVG_LOAN
    table8.append({'t': t, 'Approval %': f'{apr:.1f}%',
