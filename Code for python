# 17.  FIGURE 10 + TABLE 8 — Portfolio Decision Rule  (Section 6.2)
# ══════════════════════════════════════════════════════════════════════════════
gb_proba  = results['Gradient Boosting']['proba']
LGD       = 0.45
AVG_LOAN  = df['credit_amount'].mean()

thresholds = np.arange(0.10, 0.91, 0.01)
appr_rates, def_rates, recalls, precisions, f1s = [], [], [], [], []

for t in thresholds:
    approved = gb_proba < t
    appr_rates.append(approved.mean() * 100)
    def_rates.append(y_test[approved].mean() * 100 if approved.sum() > 0 else 0)
    pred_t = (gb_proba >= t).astype(int)
    from sklearn.metrics import recall_score, precision_score
    recalls.append(recall_score(y_test, pred_t, zero_division=0))
    precisions.append(precision_score(y_test, pred_t, zero_division=0))
    f1s.append(f1_score(y_test, pred_t, zero_division=0))

best_t_idx = int(np.argmax(f1s))
best_t     = thresholds[best_t_idx]

fig, axes = plt.subplots(1, 2, figsize=(13, 5))
fig.suptitle('Figure 10: Portfolio Decision Rule — Threshold Analysis',
             fontsize=12, fontweight='bold')

# Left: Approval rate vs default rate in approved pool
ax1 = axes[0]
ax2 = ax1.twinx()
ax1.plot(thresholds, appr_rates,  color=BLUE, lw=2, label='Approval Rate (%)')
ax2.plot(thresholds, def_rates,   color=RED,  lw=2, linestyle='--',
         label='Default in Approved (%)')
ax1.set_xlabel('Threshold t')
ax1.set_ylabel('Approval Rate (%)', color=BLUE)
ax2.set_ylabel('Default Rate in Approved Pool (%)', color=RED)
ax1.axvline(best_t, color='green', lw=1.5, linestyle=':')
ax1.tick_params(axis='y', labelcolor=BLUE)
ax2.tick_params(axis='y', labelcolor=RED)
lines1, lbls1 = ax1.get_legend_handles_labels()
lines2, lbls2 = ax2.get_legend_handles_labels()
ax1.legend(lines1 + lines2, lbls1 + lbls2, fontsize=8, loc='upper left')
ax1.set_title('Approval Rate vs Portfolio Default Rate')

# Right: Precision / Recall / F1 vs threshold
axes[1].plot(thresholds, recalls,    color=RED,   lw=2, label='Recall')
axes[1].plot(thresholds, precisions, color=BLUE,  lw=2, label='Precision')
axes[1].plot(thresholds, f1s,        color='green', lw=2, label='F1-Score')
axes[1].axvline(best_t, color='green', lw=1.5, linestyle=':',
                label=f'Optimal t={best_t:.2f}')
axes[1].set_xlabel('Threshold t')
axes[1].set_ylabel('Score')
axes[1].set_title('Precision / Recall / F1 vs Threshold')
axes[1].legend(fontsize=8)
axes[1].set_ylim(0, 1.05)

