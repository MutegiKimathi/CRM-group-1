# 16.  FIGURE 9 — Tree-Based Feature Importance  (Section 6.1)
# ══════════════════════════════════════════════════════════════════════════════
def importance_bar(ax, model, feature_names, title, top_n=18):
    imp   = pd.Series(model.feature_importances_, index=feature_names)
    imp   = imp.nlargest(top_n).sort_values()
    top5  = imp.nlargest(5).index.tolist()
    colors = [RED if f in top5 else '#4472c4' for f in imp.index]
    bars = ax.barh(imp.index, imp.values, color=colors, edgecolor='white', alpha=0.9)
    for bar, v in zip(bars, imp.values):
        ax.text(v + 0.001, bar.get_y() + bar.get_height()/2,
                f'{v:.3f}', va='center', fontsize=7)
    ax.set_xlabel('Importance Score')
    ax.set_title(title, fontsize=10, fontweight='bold')
    ax.set_xlim(0, imp.max() * 1.22)
    return imp

fig, axes = plt.subplots(1, 2, figsize=(14, 7))
fig.suptitle('Figure 9: Tree-Based Feature Importance\nTop 5 most important vs. Other features',
             fontsize=12, fontweight='bold')

