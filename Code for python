# 13.  FIGURE 6 — ROC + Precision-Recall Curves  (Section 5.1)
# ══════════════════════════════════════════════════════════════════════════════
fig, axes = plt.subplots(1, 2, figsize=(13, 5))
fig.suptitle('Figure 6: ROC and Precision-Recall Curves — All Models',
             fontsize=12, fontweight='bold')

for (name, res), color in zip(results.items(), PALETTE):
    proba = res['proba']
    # ROC
    fpr, tpr, _ = roc_curve(y_test, proba)
    auc_val      = auc(fpr, tpr)
    axes[0].plot(fpr, tpr, lw=2, color=color, label=f'{name} (AUC={auc_val:.3f})')
    # PR
    prec, rec, _ = precision_recall_curve(y_test, proba)
    ap            = average_precision_score(y_test, proba)
    axes[1].plot(rec, prec, lw=2, color=color, label=f'{name} (AP={ap:.3f})')

axes[0].plot([0, 1], [0, 1], 'k--', lw=1, label='Random classifier')
