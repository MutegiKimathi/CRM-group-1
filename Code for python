# 7.  FEATURE ENGINEERING  (Section 3.2)
# ══════════════════════════════════════════════════════════════════════════════
# One-hot encode all 13 categorical columns
categorical_cols = ['checking_account', 'credit_history', 'purpose',
                    'savings_account', 'employment', 'personal_status',
                    'other_debtors', 'property', 'other_installments',
                    'housing', 'job', 'telephone', 'foreign_worker']

df_model = pd.get_dummies(
    df[categorical_cols + numeric_cols + ['target']],
    columns=categorical_cols,
    drop_first=True
)

# Six engineered features
df_model['loan_burden']        = df['credit_amount'] * df['installment_rate']
df_model['credit_per_month']   = df['credit_amount'] / df['duration']
df_model['age_duration_ratio'] = df['age'] / df['duration']
df_model['high_amount_flag']   = (df['credit_amount'] > df['credit_amount'].quantile(0.75)).astype(int)
df_model['long_duration_flag'] = (df['duration'] > 24).astype(int)
df_model['log_credit_amount']  = np.log1p(df['credit_amount'])

print(f"\nFinal feature space: {df_model.shape[1] - 1} features (after encoding + engineering)")

# ══════════════════════════════════════════════════════════════════════════════
# 8.  TRAIN / TEST SPLIT & SCALING  (Section 3.1)
# ══════════════════════════════════════════════════════════════════════════════
X = df_model.drop('target', axis=1)
y = df_model['target']

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.30, random_state=42, stratify=y
)
print(f"\nTrain size: {len(X_train)} | Test size: {len(X_test)}")
print(f"Train default rate: {y_train.mean():.3f} | Test default rate: {y_test.mean():.3f}")

scaler = StandardScaler()
X_train_sc = scaler.fit_transform(X_train)
X_test_sc  = scaler.transform(X_test)
X_train_sc = pd.DataFrame(X_train_sc, columns=X.columns)
X_test_sc  = pd.DataFrame(X_test_sc,  columns=X.columns)

# ══════════════════════════════════════════════════════════════════════════════
# 9.  MODEL TRAINING  (Section 3.3)
# ══════════════════════════════════════════════════════════════════════════════
print("\nTraining models …")

lr = LogisticRegression(C=1.0, max_iter=1000, class_weight='balanced', random_state=42)
lr.fit(X_train_sc, y_train)

lda = LinearDiscriminantAnalysis()
lda.fit(X_train_sc, y_train)

dt = DecisionTreeClassifier(max_depth=5, min_samples_leaf=20,
                             class_weight='balanced', random_state=42)
dt.fit(X_train, y_train)

rf = RandomForestClassifier(n_estimators=500, max_depth=8, min_samples_leaf=10,
                             class_weight='balanced', n_jobs=-1, random_state=42)
rf.fit(X_train, y_train)

gb = GradientBoostingClassifier(n_estimators=300, learning_rate=0.05,
                                 max_depth=4, subsample=0.8, random_state=42)
gb.fit(X_train, y_train)

print("  All models trained.")

# Store in a dict: name → (model, X_test_to_use, scaled?)
MODELS = {
    'Logistic Regression': (lr,  X_test_sc),
    'LDA'                : (lda, X_test_sc),
    'Decision Tree'      : (dt,  X_test),
    'Random Forest'      : (rf,  X_test),
    'Gradient Boosting'  : (gb,  X_test),
}

# ── Collect predictions ────────────────────────────────────────────────────────
results = {}
for name, (model, Xt) in MODELS.items():
    proba = model.predict_proba(Xt)[:, 1]
    pred  = model.predict(Xt)
    results[name] = {'proba': proba, 'pred': pred, 'model': model, 'Xt': Xt}

# ── Train AUC for overfit gap ──────────────────────────────────────────────────
train_aucs = {}
for name, (model, _) in MODELS.items():
    Xtr = X_train_sc if name in ('Logistic Regression', 'LDA') else X_train
    train_aucs[name] = roc_auc_score(y_train, model.predict_proba(Xtr)[:, 1])

# ══════════════════════════════════════════════════════════════════════════════
# 10.  TABLE 5 — Logistic Regression Top Coefficients  (Section 4.1)
# ══════════════════════════════════════════════════════════════════════════════
coef_df = pd.DataFrame({
    'Feature'    : X.columns,
    'Coef'       : lr.coef_[0],
    'Odds Ratio' : np.exp(lr.coef_[0]),
})
coef_df = coef_df.reindex(coef_df['Coef'].abs().sort_values(ascending=False).index)
coef_df = coef_df.head(15).reset_index(drop=True)
coef_df['Odds Ratio'] = coef_df['Odds Ratio'].round(2)
coef_df['Coef']       = coef_df['Coef'].round(3)
print("\nTable 5. Top 15 Logistic Regression Coefficients")
print(coef_df.to_string(index=False))

# ══════════════════════════════════════════════════════════════════════════════
# 11.  FIGURE 5 — Logistic Regression Coefficient Plot  (Section 4.1)
# ══════════════════════════════════════════════════════════════════════════════
top15 = coef_df.copy()

# Approximate p-values via Wald z-test (diagonal of inverse Fisher info)
from scipy.special import expit as sigmoid
n_samples = X_train_sc.shape[0]
p_hat = sigmoid(X_train_sc.values @ lr.coef_[0] + lr.intercept_[0])
W     = np.diag(p_hat * (1 - p_hat))
try:
    XtWX   = X_train_sc.values.T @ W @ X_train_sc.values
    cov    = np.linalg.inv(XtWX)
    se     = np.sqrt(np.diag(cov))
    z_stat = lr.coef_[0] / se
    p_vals = 2 * (1 - stats.norm.cdf(np.abs(z_stat)))
    se_df  = pd.DataFrame({'Feature': X.columns, 'SE': se, 'z': z_stat, 'p': p_vals})
except Exception:
    se_df = pd.DataFrame({'Feature': X.columns, 'SE': np.nan, 'z': np.nan, 'p': np.nan})

top15 = top15.merge(se_df, on='Feature', how='left')

fig, ax = plt.subplots(figsize=(9, 6))
fig.suptitle("Figure 5: Logistic Regression Coefficients (Top 15, * = p<0.05)\n95% confidence intervals shown",
             fontsize=11, fontweight='bold')

top15_rev = top15.iloc[::-1].reset_index(drop=True)
colors_lr  = [RED if c > 0 else BLUE for c in top15_rev['Coef']]
y_pos = range(len(top15_rev))

ax.barh(y_pos, top15_rev['Coef'], color=colors_lr, alpha=0.85, edgecolor='white')
# CI bars ±1.96 SE if available
if top15_rev['SE'].notna().all():
    ax.errorbar(top15_rev['Coef'], y_pos,
                xerr=1.96 * top15_rev['SE'],
                fmt='none', color='black', capsize=3, lw=0.8)
# Stars for p < 0.05
for i, (_, row) in enumerate(top15_rev.iterrows()):
    if pd.notna(row['p']) and row['p'] < 0.05:
        ax.text(0.01, i, '*', va='center', fontsize=12, color='black',
                transform=ax.get_yaxis_transform())

ax.set_yticks(list(y_pos))
ax.set_yticklabels(top15_rev['Feature'], fontsize=8)
ax.axvline(0, color='black', lw=0.8)
ax.set_xlabel('Coefficient (log-odds scale)')

from matplotlib.patches import Patch
ax.legend(handles=[Patch(facecolor=RED, label='Increases default risk'),
                   Patch(facecolor=BLUE, label='Decreases default risk')],
          fontsize=8, loc='lower right')

plt.tight_layout()
plt.savefig('plots/fig05_lr_coefficients.png', dpi=150, bbox_inches='tight')
plt.close()
print("Saved: plots/fig05_lr_coefficients.png")

# ══════════════════════════════════════════════════════════════════════════════
# 12.  TABLE 6 — Full Performance Metrics  (Section 5.1)
# ══════════════════════════════════════════════════════════════════════════════
perf_rows = []
for name, res in results.items():
    proba, pred = res['proba'], res['pred']
    test_auc = roc_auc_score(y_test, proba)
    gini     = 2 * test_auc - 1
    og       = round(train_aucs[name] - test_auc, 3)
    rep      = classification_report(y_test, pred, output_dict=True)
    tn, fp, fn, tp = confusion_matrix(y_test, pred).ravel()
    spec = tn / (tn + fp)
    perf_rows.append({
        'Model'   : name,
        'Acc.'    : round(rep['accuracy'], 3),
        'AUC'     : round(test_auc, 4),
        'Gini'    : round(gini, 4),
        'Prec.'   : round(rep['1']['precision'], 3),
        'Recall'  : round(rep['1']['recall'], 3),
        'Spec.'   : round(spec, 3),
        'F1'      : round(rep['1']['f1-score'], 3),
        'OG'      : og,
    })

perf_df = pd.DataFrame(perf_rows)
print("\nTable 6. Test Set Performance — All Models (threshold = 0.5)")
print(perf_df.to_string(index=False))

