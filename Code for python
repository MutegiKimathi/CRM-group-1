def default_rate_bars(ax, series_lbl, series_target, title, avg, order=None):
    """Horizontal bar chart of default rates per category level."""
    rates = series_target.groupby(series_lbl).mean() * 100
    if order:
        rates = rates.reindex(order)
    rates = rates.sort_values()
    colors = [RED if v > avg else BLUE for v in rates.values]
    bars = ax.barh(rates.index, rates.values, color=colors, edgecolor='white')
    ax.axvline(avg, color='navy', linestyle='--', lw=1, label=f'Avg {avg:.1f}%')
    for bar, v in zip(bars, rates.values):
        ax.text(v + 0.5, bar.get_y() + bar.get_height()/2,
                f'{v:.1f}%', va='center', fontsize=8.5, fontweight='bold')
    ax.set_title(title, fontsize=10, fontweight='bold')
    ax.set_xlabel('Default Rate (%)')
    ax.legend(fontsize=7.5)
    ax.set_xlim(0, max(rates.values) * 1.22)

