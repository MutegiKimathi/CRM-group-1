axes[0].set_title('ROC Curves'); axes[0].legend(fontsize=7.5, loc='lower right')

axes[1].axhline(y_test.mean(), color='gray', linestyle='--', lw=1, label='No-skill baseline')
axes[1].set_xlabel('Recall'); axes[1].set_ylabel('Precision')
axes[1].set_title('Precision-Recall Curves'); axes[1].legend(fontsize=7.5)
axes[1].set_ylim(0.25, 1.0)

